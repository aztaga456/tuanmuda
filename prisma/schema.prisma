// ========================================================
// PRISMA SCHEMA — TUANMUDA / NUSADIGITAL
// Paket A — Vercel Starter (PostgreSQL Neon / Supabase)
// ========================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Akun Admin CMS
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 2. Data Konten Website Dinamis (Disinkronkan dengan CMS)
model SiteContent {
  id        String   @id @default("active_content")
  key       String   @unique @default("main")
  data      Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// 3. Prospek / Leads Booking Konsultasi Klien
model Booking {
  id           String   @id @default(cuid())
  name         String
  whatsapp     String
  businessName String?
  service      String
  budget       String?
  notes        String?
  status       String   @default("PENDING") // PENDING, CONTACTED, DEAL, COMPLETED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 4. Media Storage / Metadata Gambar Upload
model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  path         String
  createdAt    DateTime @default(now())
}
